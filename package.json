{
  "name": "react_native_project_template_arch",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "arch:init": "node .arch/init.js",
    "arch:change-package-name": "node .arch/packageName.js",
    "arch:generate-env": "node .arch/generateEnv.js",
    "android:dev": "react-native run-android --mode=developmentDebug --appIdSuffix=development",
    "android:stg": "react-native run-android --mode=stagingDebug --appIdSuffix=staging",
    "android:prod": "react-native run-android --mode=productionDebug",
    "ios:dev": "react-native run-ios --scheme \"development\"",
    "ios:stg": "react-native run-ios --scheme \"staging\"",
    "ios:prod": "react-native run-ios --scheme \"production\"",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "clean": "rm -rf $TMPDIR/metro-cache $TMPDIR/react-* android/build ios/build android/.gradle android/app/build ios/Pods ios/Podfile.lock && yarn install && cd android && ./gradlew clean && cd .. && cd ios && pod install && cd ..",
    "icon:update": "npx rnvi-update-plist package.json ios/AppName/Info.plist",
    "plop:feature": "plop --plopfile plop-templates/feature/plop-feature.js"
  },
  "dependencies": {
    "@react-native-vector-icons/material-icons": "13.1.4",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@reduxjs/toolkit": "2.12.0",
    "axios": "1.20.0",
    "i18next": "26.4.2",
    "react": "19.2.7",
    "react-i18next": "17.0.13",
    "react-native": "0.87.1",
    "react-native-linear-gradient": "2.8.3",
    "react-native-localize": "3.7.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-redux": "9.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@babel/runtime": "7.29.2",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "10.7.0",
    "jest": "30.4.2",
    "plop": "4.0.5",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">= 24.3.0"
  }
}
